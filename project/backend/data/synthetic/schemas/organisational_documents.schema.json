{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEGIS AI Synthetic Organisational Document",
  "type": "array",
  "minItems": 50,
  "maxItems": 50,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "document_id",
      "document_title",
      "document_type",
      "document_version",
      "creation_date",
      "effective_date",
      "document_status",
      "organisation",
      "content",
      "sections",
      "source_reference",
      "document_pdf",
      "document_txt",
      "policy_topic",
      "policy_owner"
    ],
    "properties": {
      "document_id": {
        "type": "string",
        "minLength": 1
      },
      "document_title": {
        "type": "string",
        "minLength": 1
      },
      "document_type": {
        "type": "string",
        "minLength": 1
      },
      "document_version": {
        "type": "string",
        "minLength": 1
      },
      "creation_date": {
        "type": "string",
        "minLength": 1
      },
      "effective_date": {
        "type": "string",
        "minLength": 1
      },
      "document_status": {
        "type": "string",
        "minLength": 1
      },
      "organisation": {
        "type": "string",
        "minLength": 1
      },
      "content": {
        "type": "string",
        "minLength": 1
      },
      "sections": {
        "type": "array",
        "minItems": 5,
        "items": {
          "type": "object",
          "required": [
            "section_id",
            "heading",
            "text",
            "page"
          ],
          "properties": {
            "section_id": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "source_reference": {
        "type": "string",
        "minLength": 1
      },
      "document_pdf": {
        "type": "string",
        "minLength": 1
      },
      "document_txt": {
        "type": "string",
        "minLength": 1
      },
      "policy_topic": {
        "type": "string",
        "minLength": 1
      },
      "policy_owner": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}